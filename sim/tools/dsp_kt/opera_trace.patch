+  snprintf(path,sizeof(path),"%s_ticks.bin",p);  g_DSPT_TICKS  = fopen(path,"wb");
+  snprintf(path,sizeof(path),"%s_itrace.bin",p); g_DSPT_ITRACE = fopen(path,"wb");
+  snprintf(path,sizeof(path),"%s_io.bin",p);     g_DSPT_IO     = fopen(path,"wb");
+  if(g_DSPT_ITRACE) setvbuf(g_DSPT_ITRACE,NULL,_IOFBF,(1 << 20));
+  if(g_DSPT_IO) setvbuf(g_DSPT_IO,NULL,_IOFBF,(1 << 20));
+  atexit(dspt_close);
+  g_DSPT_STATE = 1;
+}
+
+static void
+dspt_snapshot(void)
+{
+  char const *p = getenv("OPERA_DSP_TRACE");
+  char path[4096];
+  FILE *f;
+  int i;
+
+  g_DSPT_SNAPPED = 1;
+  snprintf(path,sizeof(path),"%s_snap.bin",p);
+  f = fopen(path,"wb");
+  if(f)
+    {
+      fwrite(DSP.NMem,sizeof(DSP.NMem[0]),2048,f);
+      fwrite(DSP.IMem,sizeof(DSP.IMem[0]),1024,f);
+      fclose(f);
+    }
+  snprintf(path,sizeof(path),"%s_snap.txt",p);
+  f = fopen(path,"w");
+  if(!f)
+    return;
+  fprintf(f,"tick %u\nframe %u\nitrace_index %u\n",g_DSPT_TICK,opera_vram_log_frame,g_DSPT_INSN);
+  fprintf(f,"PC %u\nAudioOutStatus %04x\nSema4Status %04x\nSema4Data %04x\nDSPPCNT %d\nDSPPRLD %d\nAUDCNT %d\nINT %04x\n",
+          DSP.dregs.PC,DSP.dregs.AudioOutStatus,DSP.dregs.Sema4Status,DSP.dregs.Sema4Data,
+          DSP.dregs.DSPPCNT,DSP.dregs.DSPPRLD,DSP.dregs.AUDCNT,DSP.dregs.INT);
