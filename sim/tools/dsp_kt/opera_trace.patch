+/* Register dump at a traced screen write (see OPERA_REGDUMP). */
+static
+void
+regdump_emit(uint32_t const flags_,
+             uint32_t const addr_,
+             uint32_t const val_)
+{
+  int i;
+
+  g_REGDUMP_LEFT--;
+  fprintf(g_REGDUMP,"seq %u frame %u pc %08x op %08x %s addr %08x val %08x cpsr %08x regs",
+          g_TRACE_SEQ,opera_vram_log_frame,g_cur_pc,g_cur_cmd,
+          (flags_ & 2) ? "STRB" : "STR",addr_,val_,CPU.CPSR);
+  for(i = 0; i < 16; i++)
+    fprintf(g_REGDUMP," %08x",CPU.USER[i]);
+  fprintf(g_REGDUMP,"\n");
+  fflush(g_REGDUMP);
+}
+
+/* RAM + register snapshot before the instruction at OPERA_SNAP_PC (see OPERA_SNAP). */
+static
+void
+snap_check(void)
+{
+  char path[4096];
+  FILE *f;
+  int i;
+
+  if((opera_vram_log_frame != g_SNAP_FRAME) || (CPU.USER[15] != g_SNAP_PC))
+    return;
+  g_SNAP_LEFT--;
+  g_SNAP_HIT++;
+  if(g_SNAP_HIT == 1)
+    snprintf(path,sizeof(path),"%s.ram",g_SNAP_PREFIX);
+  else
+    snprintf(path,sizeof(path),"%s_%d.ram",g_SNAP_PREFIX,g_SNAP_HIT);
+  f = fopen(path,"wb");
+  if(f)
+    {
+      fwrite(DRAM,1,DRAM_SIZE + VRAM_SIZE,f);
+      fclose(f);
+    }
+  if(g_SNAP_HIT == 1)
+    snprintf(path,sizeof(path),"%s.regs",g_SNAP_PREFIX);
+  else
+    snprintf(path,sizeof(path),"%s_%d.regs",g_SNAP_PREFIX,g_SNAP_HIT);
+  f = fopen(path,"w");
+  if(!f)
+    return;
+  fprintf(f,"# Opera CPU state before executing the instruction at pc (frame = libretro frame,\n"
+            "# seq = index of this instruction in OPERA_ITRACE / the seq field of OPERA_DTRACE).\n"
+            "# RAM file: DRAM (%u bytes) then VRAM (%u bytes), ARM words little-endian.\n",
+          (unsigned)DRAM_SIZE,(unsigned)VRAM_SIZE);
+  fprintf(f,"seq %u\nframe %u\npc %08x\ncpsr %08x\nmode %02x\n",
+          g_TRACE_SEQ,opera_vram_log_frame,CPU.USER[15],CPU.CPSR,CPU.CPSR & 0x1F);
+  for(i = 0; i < 16; i++)
+    fprintf(f,"r%d %08x\n",i,CPU.USER[i]);
+  fprintf(f,"# banked (Opera layout): CASH = r8-r14 of the bank not in use (user/sys bank\n"
+            "# when in FIQ mode, otherwise the FIQ-side copy is in FIQ[]), SVC/ABT/IRQ/UND = r13,r14\n");
+  for(i = 0; i < 7; i++)
+    fprintf(f,"cash%d %08x\n",i,CPU.CASH[i]);
+  for(i = 0; i < 7; i++)
+    fprintf(f,"fiq%d %08x\n",i,CPU.FIQ[i]);
+  fprintf(f,"svc13 %08x\nsvc14 %08x\n",CPU.SVC[0],CPU.SVC[1]);
+  fprintf(f,"abt13 %08x\nabt14 %08x\n",CPU.ABT[0],CPU.ABT[1]);
+  fprintf(f,"irq13 %08x\nirq14 %08x\n",CPU.IRQ[0],CPU.IRQ[1]);
+  fprintf(f,"und13 %08x\nund14 %08x\n",CPU.UND[0],CPU.UND[1]);
+  for(i = 0; i < 6; i++)
+    fprintf(f,"spsr%d %08x\n",i,CPU.SPSR[i]);
+  fprintf(f,"nfiq %u\n",(unsigned)CPU.nFIQ);
+  fclose(f);
+}
+
+/* Tracing wrappers around the CPU data accessors (see OPERA_DTRACE). */
+static
+void
+mwritew(uint32_t const addr_,
+        uint32_t const val_)
+{
+  if(g_TRACE_STATE > 0)
+    dtrace_emit(1,addr_,val_);
+  mwritew_impl(addr_,val_);
+}
+
+static
+uint32_t
+mreadw(uint32_t const addr_)
+{
+  uint32_t const v = mreadw_impl(addr_);
+  if(g_TRACE_STATE > 0)
+    dtrace_emit(0,addr_,v);
+  return v;
+}
+
+static
+void
+mwriteb(uint32_t const addr_,
+        uint8_t  const val_)
+{
+  if(g_TRACE_STATE > 0)
+    dtrace_emit(3,addr_,val_);
+  mwriteb_impl(addr_,val_);
+}
+
+static
+uint32_t
+mreadb(uint32_t const addr_)
+{
+  uint32_t const v = mreadb_impl(addr_);
+  if(g_TRACE_STATE > 0)
+    dtrace_emit(2,addr_,v);
+  return v;
+}
