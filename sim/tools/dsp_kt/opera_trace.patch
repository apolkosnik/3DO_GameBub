--- a/libopera/opera_arm.c
+++ b/libopera/opera_arm.c
@@ -47,9 +47,292 @@
 #include "opera_swi_hle_0x5XXXX.h"
 
 #include <stdint.h>
+#include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 
+/*
+  VRAM access logging instrumentation (scratchpad build only).
+  Enabled by OPERA_VRAM_LOG=<path>; optional OPERA_VRAM_LOG_FRAMES=<min>-<max>
+  limits logging to that libretro frame range.  Every CPU data access
+  (mreadw/mwritew/mreadb/mwriteb) that lands in VRAM (DRAM_SIZE..RAM_SIZE)
+  writes one 12-byte little-endian record:
+    u32 frame; u32 (addr & 0xFFFFFF) | (flags << 24); u32 value
+  flags: bit0 = write, bit1 = 8-bit access.
+  Instruction fetches (mfetchw) and non-CPU writers (opera_io_write / DMA)
+  do not pass through these hooks.
+*/
+uint32_t opera_vram_log_frame = 0;
+static FILE    *g_VRAM_LOG       = NULL;
+static int      g_VRAM_LOG_STATE = 0; /* 0 = unchecked, 1 = on, -1 = off */
+static uint32_t g_VRAM_LOG_FMIN  = 0;
+static uint32_t g_VRAM_LOG_FMAX  = 0xFFFFFFFF;
+
+static
+void
+vram_log_close(void)
+{
+  if(g_VRAM_LOG)
+    fclose(g_VRAM_LOG);
+  g_VRAM_LOG = NULL;
+}
+
+/*
+  Optional raw dump of VRAM (host byte order of the DRAM array, i.e. '<u4'
+  words are ARM words on a little-endian host) to OPERA_VRAM_DUMP=<path>.
+  Called from retro_unload_game while DRAM is still allocated.
+*/
+void
+opera_vram_dump(void)
+{
+  char const *dump = getenv("OPERA_VRAM_DUMP");
+
+  if(dump && *dump && DRAM)
+    {
+      FILE *f = fopen(dump,"wb");
+      if(f)
+        {
+          fwrite(&DRAM[DRAM_SIZE],1,VRAM_SIZE,f);
+          fclose(f);
+        }
+    }
+}
+
+static
+void
+vram_log_init(void)
+{
+  char const *path  = getenv("OPERA_VRAM_LOG");
+  char const *range = getenv("OPERA_VRAM_LOG_FRAMES");
+
+  g_VRAM_LOG_STATE = -1;
+  if(!path || !*path)
+    return;
+  g_VRAM_LOG = fopen(path,"wb");
+  if(!g_VRAM_LOG)
+    return;
+  setvbuf(g_VRAM_LOG,NULL,_IOFBF,(1 << 20));
+  if(range && *range)
+    sscanf(range,"%u-%u",&g_VRAM_LOG_FMIN,&g_VRAM_LOG_FMAX);
+  atexit(vram_log_close);
+  g_VRAM_LOG_STATE = 1;
+}
+
+static
+void
+vram_log(uint32_t const flags_,
+         uint32_t const addr_,
+         uint32_t const val_)
+{
+  uint32_t rec[3];
+
+  if(g_VRAM_LOG_STATE <= 0)
+    {
+      if(g_VRAM_LOG_STATE == 0)
+        vram_log_init();
+      if(g_VRAM_LOG_STATE < 0)
+        return;
+    }
+
+  if((opera_vram_log_frame < g_VRAM_LOG_FMIN) ||
+     (opera_vram_log_frame > g_VRAM_LOG_FMAX))
+    return;
+
+  rec[0] = opera_vram_log_frame;
+  rec[1] = ((addr_ & 0x00FFFFFF) | (flags_ << 24));
+  rec[2] = val_;
+  fwrite(rec,sizeof(rec),1,g_VRAM_LOG);
+}
+
+void
+opera_vram_log_flush(void)
+{
+  if(g_VRAM_LOG)
+    fflush(g_VRAM_LOG);
+}
+
+/*
+  Instruction / data trace instrumentation (scratchpad build only).
+  OPERA_ITRACE=<path>   one 20-byte LE record per executed opera_arm_execute:
+      u32 pc; u32 opcode; u32 cpsr_before; u32 info; u32 cycles
+      info: bit0 condition passed, bit1 SWI taken, bit2 undefined/coproc trap,
+            bit3 data abort, bit4 FIQ taken after this instruction,
+            bits 8-15 data accesses made by this instruction,
+            bits 16-31 libretro frame (low 16 bits)
+  OPERA_DTRACE=<path>   one 20-byte LE record per CPU data access (any address)
+      u32 seq (index of the itrace record); u32 pc; u32 addr (unmasked);
+      u32 value; u32 flags: bit0 write, bit1 8-bit, bit2 XBUS DMA block
+      (addr = target, value = length), bits 8-31 frame
+  OPERA_TRACE_FRAMES=<min>-<max> frame window (default: all)
+  OPERA_REGDUMP=<path> OPERA_REGDUMP_FRAME=<n> [OPERA_REGDUMP_N=<k>]
+      text dump of r0-r15/CPSR at the first k screen (0x200000-0x2EFFFF)
+      writes in frame n.
+*/
+static FILE    *g_ITRACE        = NULL;
+static FILE    *g_DTRACE        = NULL;
+static FILE    *g_REGDUMP       = NULL;
+static int      g_TRACE_STATE   = 0;  /* 0 = unchecked, 1 = on, -1 = off */
+static uint32_t g_TRACE_FMIN    = 0;
+static uint32_t g_TRACE_FMAX    = 0xFFFFFFFF;
+static uint32_t g_TRACE_SEQ     = 0;
+static uint32_t g_cur_pc        = 0;
+static uint32_t g_cur_cmd       = 0;
+static uint32_t g_insn_accesses = 0;
+static uint32_t g_REGDUMP_FRAME = 0xFFFFFFFF;
+static int      g_REGDUMP_LEFT  = 0;
+/*
+  OPERA_SNAP=<prefix> OPERA_SNAP_FRAME=<n> OPERA_SNAP_PC=<hex> [OPERA_SNAP_N=<k>]
+      before executing the instruction at PC in frame n (first k hits, default 1):
+      <prefix>.ram  = DRAM then VRAM, raw (DRAM_SIZE + VRAM_SIZE bytes; every
+                      aligned 4-byte group is one ARM word, little-endian host
+                      order, i.e. numpy '<u4' gives the ARM word at byte offset*4)
+      <prefix>.regs = text: itrace seq of this instruction, frame, pc, cpsr,
+                      r0-r15 of the current mode, the banked registers and SPSRs
+*/
+static char const *g_SNAP_PREFIX = NULL;
+static uint32_t    g_SNAP_FRAME  = 0xFFFFFFFF;
+static uint32_t    g_SNAP_PC     = 0xFFFFFFFF;
+static int         g_SNAP_LEFT   = 0;
+static int         g_SNAP_HIT    = 0;
+static void snap_check(void);
+
+static
+void
+trace_close(void)
+{
+  if(g_ITRACE)
+    fclose(g_ITRACE);
+  if(g_DTRACE)
+    fclose(g_DTRACE);
+  if(g_REGDUMP)
+    fclose(g_REGDUMP);
+  g_ITRACE = g_DTRACE = g_REGDUMP = NULL;
+}
+
+static
+void
+trace_init(void)
+{
+  char const *ip = getenv("OPERA_ITRACE");
+  char const *dp = getenv("OPERA_DTRACE");
+  char const *rp = getenv("OPERA_REGDUMP");
+  char const *range = getenv("OPERA_TRACE_FRAMES");
+  char const *rf = getenv("OPERA_REGDUMP_FRAME");
+  char const *rn = getenv("OPERA_REGDUMP_N");
+
+  g_TRACE_STATE = -1;
+  if(ip && *ip)
+    {
+      g_ITRACE = fopen(ip,"wb");
+      if(g_ITRACE)
+        setvbuf(g_ITRACE,NULL,_IOFBF,(1 << 20));
+    }
+  if(dp && *dp)
+    {
+      g_DTRACE = fopen(dp,"wb");
+      if(g_DTRACE)
+        setvbuf(g_DTRACE,NULL,_IOFBF,(1 << 20));
+    }
+  if(rp && *rp && rf && *rf)
+    {
+      g_REGDUMP = fopen(rp,"w");
+      g_REGDUMP_FRAME = (uint32_t)strtoul(rf,NULL,0);
+      g_REGDUMP_LEFT = (rn && *rn) ? atoi(rn) : 16;
+    }
+  if(range && *range)
+    sscanf(range,"%u-%u",&g_TRACE_FMIN,&g_TRACE_FMAX);
+  {
+    char const *sp = getenv("OPERA_SNAP");
+    char const *sf = getenv("OPERA_SNAP_FRAME");
+    char const *spc = getenv("OPERA_SNAP_PC");
+    char const *sn = getenv("OPERA_SNAP_N");
+    if(sp && *sp && sf && *sf && spc && *spc)
+      {
+        g_SNAP_PREFIX = sp;
+        g_SNAP_FRAME  = (uint32_t)strtoul(sf,NULL,0);
+        g_SNAP_PC     = (uint32_t)strtoul(spc,NULL,16);
+        g_SNAP_LEFT   = (sn && *sn) ? atoi(sn) : 1;
+      }
+  }
+  if(g_ITRACE || g_DTRACE || g_REGDUMP || g_SNAP_LEFT)
+    {
+      atexit(trace_close);
+      g_TRACE_STATE = 1;
+    }
+}
+
+static
+OPERA_FORCEINLINE
+int
+trace_in_window(void)
+{
+  return ((g_TRACE_STATE > 0) &&
+          (opera_vram_log_frame >= g_TRACE_FMIN) &&
+          (opera_vram_log_frame <= g_TRACE_FMAX));
+}
+
+static
+void
+itrace_emit(uint32_t const pc_,
+            uint32_t const cmd_,
+            uint32_t const cpsr_,
+            uint32_t const info_,
+            uint32_t const cycles_)
+{
+  uint32_t rec[5];
+
+  if(!trace_in_window())
+    return;
+  g_TRACE_SEQ++;
+  if(!g_ITRACE)
+    return;
+  rec[0] = pc_;
+  rec[1] = cmd_;
+  rec[2] = cpsr_;
+  rec[3] = (info_ | ((g_insn_accesses & 0xFF) << 8) |
+            ((opera_vram_log_frame & 0xFFFF) << 16));
+  rec[4] = cycles_;
+  fwrite(rec,sizeof(rec),1,g_ITRACE);
+}
+
+static void regdump_emit(uint32_t const flags_,
+                         uint32_t const addr_,
+                         uint32_t const val_);
+
+static
+void
+dtrace_emit(uint32_t const flags_,
+            uint32_t const addr_,
+            uint32_t const val_)
+{
+  uint32_t rec[5];
+
+  g_insn_accesses++;
+  if(!trace_in_window())
+    return;
+  if(g_DTRACE)
+    {
+      rec[0] = g_TRACE_SEQ;
+      rec[1] = g_cur_pc;
+      rec[2] = addr_;
+      rec[3] = val_;
+      rec[4] = (flags_ | (opera_vram_log_frame << 8));
+      fwrite(rec,sizeof(rec),1,g_DTRACE);
+    }
+  if(g_REGDUMP && (g_REGDUMP_LEFT > 0) && (flags_ & 1) &&
+     (opera_vram_log_frame == g_REGDUMP_FRAME) &&
+     (addr_ >= 0x200000) && (addr_ < 0x2F0000))
+    regdump_emit(flags_,addr_,val_);
+}
+
+void
+opera_dtrace_dma(uint32_t const addr_,
+                 uint32_t const len_)
+{
+  if(g_TRACE_STATE > 0)
+    dtrace_emit(4,addr_,len_);
+}
