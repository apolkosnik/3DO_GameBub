+static FILE    *g_DSPT_TICKS  = NULL;
+static FILE    *g_DSPT_ITRACE = NULL;
+static FILE    *g_DSPT_IO     = NULL;
+static int      g_DSPT_STATE  = 0;      /* 0 unchecked, 1 on, -1 off */
+static uint32_t g_DSPT_FMIN   = 0;
+static uint32_t g_DSPT_FMAX   = 0xFFFFFFFF;
