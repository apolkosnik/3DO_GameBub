+
+static void
+dspt_init(void)
+{
+  char const *p = getenv("OPERA_DSP_TRACE");
+  char const *r = getenv("OPERA_DSP_FRAMES");
+  char path[4096];
+
+  g_DSPT_STATE = -1;
+  if(!p || !*p)
